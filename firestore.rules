rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // Tours collection
    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Places / Attractions collection
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hotels collection
    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      // Public reviews (the app) start unpublished; the homepage shows only
      // reviews without approved == false, and an admin publishes them.
      allow create: if isAdmin() || (
        request.resource.data.approved == false &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text is string && request.resource.data.text.size() <= 2000
      );
      allow update, delete: if isAdmin();
    }

    // Analytics and Visitor Sessions
    match /visitor_sessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Events are append-only: a visitor can add one but never rewrite it.
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // WhatsApp chats mirrored by /api/whatsapp/webhook (server writes only).
    // Admins read them and may reset the unread counter.
    match /whatsapp_conversations/{phone} {
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread']);

      match /messages/{messageId} {
        allow read: if isAdmin();
      }
    }

    // Names saved in the business phone's address book.
    match /whatsapp_contacts/{phone} {
      allow read: if isAdmin();
    }
    // whatsapp_config holds the access token: no client access at all.

    // Facebook Page (Messenger) chats mirrored by /api/messenger/webhook.
    match /messenger_conversations/{psid} {
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread']);

      match /messages/{messageId} {
        allow read: if isAdmin();
      }
    }
    // messenger_config holds the Page token: no client access at all.

    // Global Site / Coupon Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dynamic Coupons Collection (Managed from Admin)
    // A code can be looked up once someone types it, but the list of all
    // codes (including inactive or private ones) is for admins only.
    match /coupons/{couponId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Claimed coupon IPs ("<ip>") and per-user coupon uses ("use__CODE__uid").
    // A visitor can check one record whose ID they already know, but not list
    // the collection (it holds IPs, user IDs and booking IDs). The welcome
    // popup may add an IP record; coupon-use records are written by the
    // booking server through the Admin SDK, so the browser cannot forge them.
    match /claimed_coupon_ips/{ipDoc} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if !ipDoc.matches('use__.*') &&
        request.resource.data.keys().hasOnly(['ip', 'userId', 'claimedAt']) &&
        request.resource.data.ip is string && request.resource.data.ip.size() <= 64;
      allow update, delete: if isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Customer data: admins only. /api/bookings/create and /status use the
      // Admin SDK (server credentials), which these rules do not apply to.
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']))
      );
      allow delete: if isAdmin();
    }

    // Community Posts & Blog
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /likes/{userId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }

      match /votes/{userId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }
  }
}

