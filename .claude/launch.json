{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "georgiatrips-dev",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "georgiatrips-dev-start",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
